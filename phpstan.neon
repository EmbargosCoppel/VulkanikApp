parameters:
    level: 5
    paths:
        - app
        - config
        - database
        - routes
    excludePaths:
        - app/Console/Commands/PromoteUser.php
    ignoreErrors:
        - '#Call to an undefined method Illuminate\\Support\\Facades\\Storage::lastModified#'
        - '#Call to an undefined method Illuminate\\Support\\Facades\\Storage::files#'
        - '#Call to an undefined method Illuminate\\Support\\Facades\\Storage::delete#'
