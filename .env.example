APP_NAME="Vulcanizadora Don Chuy"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vulkanikapp
# DB_USERNAME=sail
# DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_STORE=redis (para producciรณn)

VITE_APP_NAME="${APP_NAME}"

# Configuraciรณn de Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000
SANCTUM_TOKEN_PREFIX=

# Configuraciรณn de IVA (16% para Mรฉxico)
IVA_RATE=0.16

# Configuraciรณn de Paginaciรณn
PAGINATION_PER_PAGE=15

# Configuraciรณn de Seeders
ADMIN_PASSWORD=change-me-immediately
MECANICO_PASSWORD=change-me-immediately

# Configuraciรณn de Pagos (Stripe)
PAYMENT_CURRENCY=mxn
STRIPE_KEY=
STRIPE_SECRET=

# Configuraciรณn de Backup
BACKUP_DISK=local
BACKUP_PATH=backups

# Configuraciรณn de Redis (producciรณn)
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Configuraciรณn de Correo
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@vulcanizadora.com
MAIL_FROM_NAME="${APP_NAME}"

# Configuraciรณn de Frontend (para CORS)
FRONTEND_URL=http://localhost:3000
